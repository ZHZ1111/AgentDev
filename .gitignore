# Secrets (keep the distributable placeholder example)
.env
.env.*
!.env.example

# Local Python environments and packaging
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test caches and coverage intermediates
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.json
coverage.xml
htmlcov/

# Per-run artifacts and temporary workspaces
outputs/
.work/
tmp/
*.log

# F1 selected raw acceptance evidence (no coverage databases or credentials)
!evaluation/f1/**/coverage.json
!evaluation/f1/**/*.log

# F2 handwritten fixture-validation evidence
!evaluation/f2/**/coverage.json
!evaluation/f2/**/*.log
