  "source_code": "\"\"\"标签规范化与展示参考实现。\"\"\"\n\ndef normalize_labels(labels):\n    \"\"\"依次 strip/lower，删除空项；保留顺序及重复。\"\"\"\n    result = []\n    for label in labels:\n        normalized = label.strip().lower()\n        if normalized:\n            result.append(normalized)\n    return result\n\ndef format_labels(labels):\n    \"\"\"用英文逗号加一个空格拼接真实规范化结果。\"\"\"\n    return \", \".join(normalize_labels(labels))\n\n",
