    "source_code": "\"\"\"留出集：多分支报文分类参考实现。\"\"\"\n\ndef classify_packet(packet):\n    \"\"\"仅支持 PING: 或 DATA:非空载荷，其他格式抛 ValueError。\"\"\"\n    if packet.count(\":\") != 1:\n        raise ValueError(\"format\")\n    kind, payload = packet.split(\":\")\n    if kind == \"PING\":\n        if payload:\n            raise ValueError(\"payload\")\n        return \"heartbeat\"\n    if kind == \"DATA\":\n        if not payload:\n            raise ValueError(\"payload\")\n        return \"data\"\n    raise ValueError(\"kind\")\n\n",
